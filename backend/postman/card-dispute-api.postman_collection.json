{
  "info": {
    "name": "Card Dispute POC API",
    "description": "Increment 1 endpoints of the Card Dispute POC backend (synthetic data only).\n\nAuth: HTTP Basic with the demo users (customer01 / customer02 / analyst01, password `demo`). The collection uses customer01 by default; folders override it where needed.\n\nEvery request gets a random `X-Correlation-Id` header (collection pre-request script). Successful submissions store the new id in the `disputeId` collection variable, used by the query requests.\n\nRun the 'Submit scenarios' folder once on a fresh seed: re-running it returns 409 OPEN_DISPUTE_EXISTS while those disputes are still open.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      { "key": "username", "value": "{{customerUser}}", "type": "string" },
      { "key": "password", "value": "{{password}}", "type": "string" }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.request.headers.upsert({ key: 'X-Correlation-Id', value: pm.variables.replaceIn('{{$guid}}') });"
        ]
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "customerUser", "value": "customer01" },
    { "key": "customer2User", "value": "customer02" },
    { "key": "analystUser", "value": "analyst01" },
    { "key": "password", "value": "demo" },
    { "key": "disputeId", "value": "", "description": "Last dispute created by any submission" },
    { "key": "customer01DisputeId", "value": "", "description": "Dispute created by 'Cafe Aroma' (customer01)" }
  ],
  "item": [
    {
      "name": "00 - Auth checks",
      "item": [
        {
          "name": "No credentials -> 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 problem+json', () => {",
                  "  pm.response.to.have.status(401);",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "  pm.expect(pm.response.json().errorCode).to.eql('UNAUTHENTICATED');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/disputes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "disputes"]
            }
          }
        },
        {
          "name": "Wrong password -> 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('401', () => pm.response.to.have.status(401));"]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{customerUser}}", "type": "string" },
                { "key": "password", "value": "wrong-password", "type": "string" }
              ]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/disputes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "disputes"]
            }
          }
        }
      ]
    },
    {
      "name": "01 - Transactions (customer)",
      "item": [
        {
          "name": "List posted transactions",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 with only POSTED', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.content).to.be.an('array').that.is.not.empty;",
                  "  body.content.forEach(t => pm.expect(t.status).to.eql('POSTED'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/transactions?status=POSTED&page=0&size=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "transactions"],
              "query": [
                { "key": "status", "value": "POSTED", "description": "POSTED | PENDING | REVERSED (optional)" },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "List all transactions (sorted by amount)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('200', () => pm.response.to.have.status(200));"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/transactions?size=50&sort=amount,desc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "transactions"],
              "query": [
                { "key": "size", "value": "50" },
                { "key": "sort", "value": "amount,desc" }
              ]
            }
          }
        },
        {
          "name": "Get transaction by id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 with reference', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().reference).to.eql('SYN-0001');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/transactions/aaaaaaaa-0000-0000-0000-000000000001",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "transactions", "aaaaaaaa-0000-0000-0000-000000000001"]
            }
          }
        },
        {
          "name": "Get transaction of another customer -> 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 TRANSACTION_NOT_FOUND', () => {",
                  "  pm.response.to.have.status(404);",
                  "  pm.expect(pm.response.json().errorCode).to.eql('TRANSACTION_NOT_FOUND');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/transactions/aaaaaaaa-0000-0000-0000-000000000021",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "transactions", "aaaaaaaa-0000-0000-0000-000000000021"]
            }
          }
        },
        {
          "name": "Analyst lists transactions -> 403",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403 ACCESS_DENIED', () => {",
                  "  pm.response.to.have.status(403);",
                  "  pm.expect(pm.response.json().errorCode).to.eql('ACCESS_DENIED');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{analystUser}}", "type": "string" },
                { "key": "password", "value": "{{password}}", "type": "string" }
              ]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "transactions"]
            }
          }
        }
      ]
    },
    {
      "name": "02 - Submit scenarios (customer)",
      "description": "Each request submits one seeded scenario. The expected assessment outcome is in the request name; it is applied once the workflow delegates (BE-2) call DisputeLifecycleService. Until then disputes stay SUBMITTED.",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => {",
              "  pm.response.to.have.status(201);",
              "  pm.expect(pm.response.headers.get('Location')).to.include('/api/v1/disputes/');",
              "  const body = pm.response.json();",
              "  pm.expect(body.status).to.eql('SUBMITTED');",
              "  pm.expect(body.candidateTransaction).to.be.an('object');",
              "  pm.collectionVariables.set('disputeId', body.disputeId);",
              "});"
            ]
          }
        }
      ],
      "item": [
