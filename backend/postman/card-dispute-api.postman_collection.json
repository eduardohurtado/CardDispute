                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transactionId\": \"d0020000-0000-4000-8000-000000000011\",\n  \"candidateTransactionId\": \"d0020000-0000-4000-8000-000000000012\",\n  \"reasonCode\": \"POSSIBLE_DUPLICATE\",\n  \"description\": \"I was charged twice for the same purchase\"\n}",
