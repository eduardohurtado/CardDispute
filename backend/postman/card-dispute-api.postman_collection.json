    {
      "name": "03 - Submit errors (customer)",
      "description": "Rejected submissions: no dispute is created. Run after '02 - Submit scenarios' so the 409 requests find the open P03 dispute (MANUAL_REVIEW stays IN_REVIEW).",
      "item": [
        {
          "name": "Missing candidate -> 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 VALIDATION_FAILED on candidateTransactionId', () => {",
                  "  pm.response.to.have.status(400);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.errorCode).to.eql('VALIDATION_FAILED');",
                  "  pm.expect(body.violations.map(v => v.field)).to.include('candidateTransactionId');",
                  "});"
