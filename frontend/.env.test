# Loaded by Vitest (mode "test").
#
# The base URL must be absolute in tests: Node's fetch rejects relative URLs
# ("Failed to parse URL from /api/v1/disputes") and jsdom does not implement
# fetch, so the test environment falls back to Node's fetch implementation.
VITE_API_URL=http://localhost:3000/api
# The test suite always runs against the MSW handlers.
VITE_USE_MOCKS=true
