# Copy to .env.local and adjust.

# Base URL for API calls. Keep `/api` so the dev server proxies to the backend.
VITE_API_URL=/api

# Where the dev server proxy sends `/api` calls (not exposed to the browser).
BACKEND_URL=http://localhost:8080

# Password of the synthetic demo users (customer01, customer02). Synthetic only.
VITE_DEMO_PASSWORD=demo

# Set to "true" to serve the app from the local Mock Service Worker fixtures
# instead of a running backend. Handlers live in src/mocks/.
VITE_USE_MOCKS=false
